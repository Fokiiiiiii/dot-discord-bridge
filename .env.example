# Placeholders only. Set securely on the approved deployment host.
DISCORD_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN_NOT_USER_TOKEN
# Default OAuth mode. Three distinct secrets: Bot, client, owner approval.
MCP_AUTH_MODE=oauth
OAUTH_ISSUER=https://discord-mcp.foki.sh
OAUTH_CLIENT_ID=discord-dot-owner
OAUTH_CLIENT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
OAUTH_OWNER_APPROVAL_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Exact redirect shown by ChatGPT connection management, NOT an event callback.
OAUTH_REDIRECT_URIS=https://REPLACE-WITH-EXACT-CHATGPT-REDIRECT.example/callback
# Legacy manual diagnostics only: MCP_AUTH_MODE=bearer explicitly, then set this.
# MCP_BEARER_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Exactly one owner. No guild/channel ID configuration is needed.
DISCORD_OWNER_USER_ID=222222222222222222
CALLBACK_ALLOWED_HOSTS=REPLACE_WITH_VERIFIED_CALLBACK_HOSTNAME
MCP_ALLOWED_HOSTS=REPLACE_WITH_YOUR_PUBLIC_MCP_HOSTNAME
DATABASE_PATH=discord-dm.sqlite3
PORT=8787

# Cosmetic typing lease: 0 disables, default120, maximum300 seconds.
TYPING_TIMEOUT_SECS=120
# Same-owner same-DM context entries: 0 disables recent history, default10, max20.
RECENT_CONTEXT_LIMIT=10
