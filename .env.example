# Discord Bot token (never use a user token)
DISCORD_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN

# Single owner Discord snowflake ID (17-20 digits)
DISCORD_OWNER_USER_ID=222222222222222222

# Authentication mode: "oauth" (recommended) or "bearer" (diagnostics only)
MCP_AUTH_MODE=oauth
OAUTH_ISSUER=https://discord-mcp.example.com
OAUTH_CLIENT_ID=discord-dot-owner
# Generate each secret independently with: openssl rand -hex 32
OAUTH_CLIENT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARS
OAUTH_OWNER_APPROVAL_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
# Exact OAuth redirect URI shown by the MCP client
OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect

# Exact public hostname(s) serving this bridge and allowed webhook callback host(s)
MCP_ALLOWED_HOSTS=discord-mcp.example.com
CALLBACK_ALLOWED_HOSTS=REPLACE_WITH_VERIFIED_CALLBACK_HOSTNAME

# Runtime & storage
DATABASE_PATH=/data/discord-dm.sqlite3
PORT=8787
TYPING_TIMEOUT_SECS=120
RECENT_CONTEXT_LIMIT=10

# Optional: enable guild/server channel support and additional responder allowlist
# DISCORD_GUILD_ENABLED=false
# DISCORD_RESPONDERS_FILE=/data/responders.json

# Legacy static bearer token (only when MCP_AUTH_MODE=bearer)
# MCP_BEARER_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
